generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SEEKER
  EMPLOYER
  ADMIN
}

enum ContractType {
  CDI
  CDD
  STAGE
  FREELANCE
  ALTERNANCE
  INTERIM
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  EXPIRED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  REJECTED
  HIRED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

// ============================================================
// USERS
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  role          UserRole @default(SEEKER)
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile      Profile?
  company      Company?
  applications Application[]
  savedJobs    SavedJob[]
  adminLogs    AdminLog[]    @relation("AdminLogs")
  targetLogs   AdminLog[]    @relation("TargetLogs")

  @@map("users")
}

// ============================================================
// PROFILES (Job Seekers)
// ============================================================

model Profile {
  id              String    @id @default(cuid())
  userId          String    @unique
  firstName       String
  lastName        String
  phone           String?
  city            String?
  country         String    @default("Maroc")
  bio             String?   @db.Text
  avatarUrl       String?
  cvUrl           String?
  cvFileName      String?
  linkedinUrl     String?
  portfolioUrl    String?
  whatsappNumber  String?
  preferredLang   String    @default("fr")
  isOpenToWork    Boolean   @default(true)
  expectedSalary  Int?
  experienceYears Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills      Skill[]
  experiences Experience[]
  educations  Education[]

  @@map("profiles")
}

model Skill {
  id        String   @id @default(cuid())
  profileId String
  name      String
  level     String?
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Experience {
  id          String    @id @default(cuid())
  profileId   String
  title       String
  company     String
  city        String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?   @db.Text
  createdAt   DateTime  @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

model Education {
  id          String    @id @default(cuid())
  profileId   String
  degree      String
  school      String
  field       String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?   @db.Text
  createdAt   DateTime  @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("educations")
}

// ============================================================
// COMPANIES
// ============================================================

model Company {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String
  slug            String   @unique
  logoUrl         String?
  coverUrl        String?
  website         String?
  linkedinUrl     String?
  description     String?  @db.Text
  industry        String?
  size            String?
  city            String?
  address         String?
  phone           String?
  email           String?
  whatsappNumber  String?
  isVerified      Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs          Job[]
  subscriptions Subscription[]

  @@map("companies")
}

// ============================================================
// JOBS
// ============================================================

model Job {
  id               String          @id @default(cuid())
  companyId        String
  title            String
  slug             String          @unique
  description      String          @db.Text
  requirements     String?         @db.Text
  benefits         String?         @db.Text
  city             String
  country          String          @default("Maroc")
  contractType     ContractType
  workMode         WorkMode        @default(ONSITE)
  experienceLevel  ExperienceLevel @default(MID)
  category         String
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String          @default("MAD")
  salaryPeriod     String          @default("month")
  skills           String[]
  status           JobStatus       @default(PENDING_REVIEW)
  isFeatured       Boolean         @default(false)
  isUrgent         Boolean         @default(false)
  viewCount        Int             @default(0)
  applyUrl         String?
  whatsappApply    String?
  expiresAt        DateTime?
  publishedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
  savedBy      SavedJob[]

  @@map("jobs")
}

// ============================================================
// APPLICATIONS
// ============================================================

model Application {
  id           String            @id @default(cuid())
  jobId        String
  userId       String
  coverLetter  String?           @db.Text
  cvUrl        String?
  cvFileName   String?
  status       ApplicationStatus @default(PENDING)
  aiScore      Int?
  notes        String?           @db.Text
  appliedAt    DateTime          @default(now())
  reviewedAt   DateTime?
  updatedAt    DateTime          @updatedAt

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@map("applications")
}

// ============================================================
// SAVED JOBS
// ============================================================

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  savedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("saved_jobs")
}

// ============================================================
// SUBSCRIPTIONS
// ============================================================

model Subscription {
  id         String             @id @default(cuid())
  companyId  String
  plan       SubscriptionPlan   @default(FREE)
  status     SubscriptionStatus @default(ACTIVE)
  jobsLimit  Int                @default(3)
  jobsUsed   Int                @default(0)
  features   String[]
  startDate  DateTime           @default(now())
  endDate    DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ============================================================
// ADMIN LOGS
// ============================================================

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  targetId   String?
  action     String
  entity     String
  entityId   String?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  admin  User  @relation("AdminLogs", fields: [adminId], references: [id])
  target User? @relation("TargetLogs", fields: [targetId], references: [id])

  @@map("admin_logs")
}
